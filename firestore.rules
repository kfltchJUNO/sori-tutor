rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 관리자 검증 함수 ──
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        get(/databases/$(database)/documents/sori_users/$(request.auth.token.email)).data.role == "admin";
    }

    // ── 로그인 유저 본인 검증 ──
    function isOwner(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    // ── 사용자 프로필 컬렉션 (sori_users) ──
    match /sori_users/{userEmail} {
      // 본인 또는 관리자만 조회 가능 (랭킹용 상위 10개 공개 허용)
      allow read: if isOwner(userEmail) || isAdmin() || (request.query.limit <= 10);

      // 신규 가입 시 기본 프로필 생성 허용 (초기 토큰 0 고정 검증)
      allow create: if isOwner(userEmail) &&
        request.resource.data.tokens == 0 &&
        request.resource.data.role == "guest";

      // 프로필 수정: alias, daily_count, last_access_date 등 비재화 필드만 허용
      // tokens, role, free_hearts, purchased_steps 조작은 원천 차단 (서버 Admin SDK만 가능)
      allow update: if isOwner(userEmail) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tokens', 'role', 'free_hearts', 'purchased_steps']);

      allow delete: if isAdmin();

      // 유저 하위 컬렉션: 학습 기록
      match /history/{historyId} {
        allow read, create: if isOwner(userEmail);
        allow update, delete: if isOwner(userEmail) || isAdmin();
      }

      // 유저 하위 컬렉션: 메일함 (읽음 처리만 유저 허용, 메시지 생성은 서버/관리자)
      match /inbox/{messageId} {
        allow read: if isOwner(userEmail);
        allow update: if isOwner(userEmail) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      // 유저 하위 컬렉션: 단어장
      match /vocabulary/{vocabId} {
        allow read, write: if isOwner(userEmail);
      }

      // 유저 하위 컬렉션: 토큰 거래 내역 (읽기 전용)
      match /token_logs/{logId} {
        allow read: if isOwner(userEmail) || isAdmin();
        allow write: if false; // 서버 Admin SDK 전용
      }
    }

    // ── 커리큘럼 컬렉션 (단어, 문장, 담화) ──
    match /sori_curriculum_word/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /sori_curriculum_sentence/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /sori_curriculum_dialogue/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── 관리자 CMS 및 초안 컬렉션 ──
    match /sori_drafts/{draftId} {
      allow read, write: if isAdmin();
    }
    match /sori_feedback_voices/{voiceId} {
      allow read: if true; // 공개 오디오 URL
      allow write: if isAdmin();
    }

    // ── 결제/라이선스 대기 (서버 Admin SDK 전용) ──
    match /sori_pending_charges/{chargeId} {
      allow read, write: if false;
    }
    match /sori_pending_licenses/{licenseId} {
      allow read, write: if false;
    }
    match /sori_license_keys/{keyId} {
      allow read, write: if false;
    }
    match /sori_inquiries/{inquiryId} {
      allow create: if request.auth != null;
      allow read, update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.token.email);
    }
    match /grammar_cache/{textId} {
      allow read: if true;
      allow write: if false; // 서버 Admin SDK 전용
    }
  }
}
